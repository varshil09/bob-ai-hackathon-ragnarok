# ============================================================
# CHAKRA — Environment Variables
# Copy this file to .env and fill in real values
# ============================================================

# --- Server ---
CHAKRA_HOST=127.0.0.1
CHAKRA_PORT=8000
CHAKRA_DEBUG=true

# --- Data ---
# Path to the FIR dataset CSV (relative to backend/ folder)
CHAKRA_DATASET_PATH=data/fir_dataset.csv

# --- Database ---
# SQLite file (auto-created on first run)
CHAKRA_DB_PATH=data/chakra.db

# --- IBM Bob / Inference API ---
# Set CHAKRA_USE_MOCK_BOB=true to use local rule-based extraction (no API key needed)
# Set to false and fill BOB_API_KEY to use real IBM Bob inference
CHAKRA_USE_MOCK_BOB=false

# ⭐ Your IBM Bob Inference API key
# Get it from: https://bob.ibm.com → Subscription → API Keys → Create (Inference type)
CHAKRA_BOB_API_KEY=your-bob-inference-key-here

# Bob endpoint (usually no change needed)
CHAKRA_BOB_BASE_URL=https://api.us-east.bob.ibm.com/inference/v1
CHAKRA_BOB_MODEL_ID=premium

# --- CORS (frontend origin) ---
CHAKRA_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000